{
  "name": "amaury-dev-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/check-i18n.mjs",
    "prebuild": "npm run i18n:check",
    "build": "npx vite build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "build:prod": "npm run clean && npm run build",
    "install:clean": "npm cache clean --force && npm install --no-optional",
    "install:force": "rmdir /s /q node_modules 2>nul & del package-lock.json 2>nul & npm install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.8",
    "framer-motion": "^12.9.2",
    "gsap": "^3.12.7",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.7.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.1"
  }
}
